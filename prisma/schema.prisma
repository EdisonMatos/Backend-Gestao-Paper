generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Usuario {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  nome    String
  email   String  @unique
  senha   String
  avatar  String?
  cargo   String?
  setor   String?
  tarefas String? @default("sem tarefas")
  tags    String? @default("sem tags")
  obs     String? @default("sem observações")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Cliente {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  empresa       String
  representante String
  telefone      String
  email         String
  dominio       String

  servicos Servico[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Servico {
  id   String  @id @default(auto()) @map("_id") @db.ObjectId
  nome String?

  clienteId String  @db.ObjectId
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  status             String?
  statusAtualizadoEm DateTime?

  dataContratacao    DateTime
  dataInfosColetadas DateTime?
  dataDocPronto      DateTime?
  dataEnvioPrevia    DateTime?
  dataConclusao      DateTime?
  dataProximoPrazo   DateTime?
  dataPrazoProjeto DateTime?
  complexidade Float?

  posicaoNoQuadro String?
  ordemVerticalNoQuadro Float?

  linkDoc          String?
  linkPreviaVercel String?
  linkRepoGithub   String?
  turnoDaVez       String?
  comentariosTexto String?

  deuFeedbackSite       Boolean? @default(false)
  feedbackSitePostado   Boolean? @default(false)
  deuFeedbackGoogle     Boolean? @default(false)
  feedbackGooglePostado Boolean? @default(false)

  comentarios Comentario[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Comentario {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  servicoId String  @db.ObjectId
  servico   Servico @relation(fields: [servicoId], references: [id])

  feitoPor String
  setor    String
  texto    String

  criadoEm DateTime @default(now())
}

model Rotina {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  nome         String
  descricao    String
  status       String
  complexidade Float
  horario      String
  janela       Float
  conclusao    DateTime?
  diaDaSemana  String
  setor        String

  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @updatedAt

  registros    RegistroRotina[] 
}

model RegistroRotina {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  dataConclusao DateTime
  comentario    String
  feitoPor      String

  rotinaId      String   @db.ObjectId
  rotina        Rotina   @relation(fields: [rotinaId], references: [id])

  criadoEm      DateTime @default(now())
}

